<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Pilot" Width="1280" Height="940" MinWidth="980" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#F4F6FB" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172554" />
        <SolidColorBrush x:Key="Accent" Color="#4338CA" />
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" /><Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="6" /><Setter Property="MinHeight" Value="32" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" /><Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="Foreground" Value="#172554" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#334155" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /></Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="14,9" /></Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" Padding="12,5">
            <MenuItem Header="_File">
                <MenuItem Name="MenuNewSession" Header="_New session" InputGestureText="Ctrl+N" />
                <MenuItem Name="MenuOpenSession" Header="_Open session..." InputGestureText="Ctrl+O" />
                <MenuItem Name="MenuSaveSession" Header="Save session _as..." InputGestureText="Ctrl+S" />
                <MenuItem Name="MenuExportSession" Header="_Export Markdown..." />
            </MenuItem>
            <MenuItem Header="_Settings"><MenuItem Name="MenuSettingsApiKey" Header="_Providers and API keys..." /><MenuItem Name="MenuModelManagement" Header="_Model recommendations..." /></MenuItem>
            <MenuItem Header="_Help"><MenuItem Name="MenuOpenLogs" Header="Open _logs folder" /><MenuItem Name="MenuHelpAbout" Header="_About and privacy" /></MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="#172554" Padding="22,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PROMPT PILOT" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Make the next action clear." Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,3" />
                    <TextBlock Text="Write your intent. Refine with care. Keep the result." Foreground="#CBD5E1" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Name="VersionTextBlock" Foreground="#C7D2FE" HorizontalAlignment="Right" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal"><Button Name="ModelsButton" Content="Models" Margin="0,0,8,0" /><Button Name="ProviderButton" Content="Configure provider" Padding="14,8" /></StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Name="SaveStateTextBlock" Text="Sessions stay on this PC." Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Name="UsageTextBlock" Text="No requests yet" Foreground="#334155" />
            </Grid>
        </Border>
        <Grid Margin="18,14,18,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Name="SessionTitleTextBlock" Text="Untitled session" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="FeedbackTextBlock" Text="Start with what you want to accomplish." TextWrapping="Wrap" Foreground="#475569" Margin="0,4,10,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox Name="AutosaveCheckBox" Content="Autosave locally" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Name="NewSessionButton" Content="New" Margin="0,0,6,0" /><Button Name="OpenSessionButton" Content="Open" Margin="0,0,6,0" />
                    <Button Name="SaveSessionButton" Content="Save as..." />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" MinWidth="370" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" MinWidth="410" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Iterations (1-5)" Style="{StaticResource Hint}" /><TextBox Name="IterationsTextBox" Text="2" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Output token limit" Style="{StaticResource Hint}" /><TextBox Name="MaxOutputTextBox" Text="2048" ToolTip="256-8192 tokens per request, including model reasoning." /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Run budget (USD)" Style="{StaticResource Hint}" /><TextBox Name="BudgetTextBox" Text="0.50" ToolTip="Conservative request budget using the selected model's token rates." /></StackPanel>
                            </Grid>
                            <TextBlock Name="PricingTextBlock" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Name="RunButton" Content="Refine prompt" Style="{StaticResource Primary}" Padding="12,10" />
                                <Button Name="AcceptIterationButton" Grid.Column="1" Content="Keep draft" IsEnabled="False" Margin="8,0,0,0" ToolTip="Stop after keeping the most recent completed revision." />
                                <Button Name="CancelButton" Grid.Column="2" Content="Cancel" IsEnabled="False" Margin="8,0,0,0" />
                            </Grid>
                            <ProgressBar Name="BusyProgressBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="1. YOUR REQUEST" FontSize="11" FontWeight="Bold" Foreground="#4338CA" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton Name="ModeRefineRadio" Content="Refine a prompt" IsChecked="True" Margin="0,0,20,0" />
                                    <RadioButton Name="ModeAnswerRadio" Content="Get an answer" />
                                </StackPanel>
                                <StackPanel Name="AnswerSourcePanel" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="Answer input" Style="{StaticResource Label}" /><ComboBox Name="AnswerSourceComboBox" /></StackPanel>
                                <TextBox Name="PromptTextBox" VerticalContentAlignment="Top" AutomationProperties.Name="Original request" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="145" Height="170" FontSize="14" />
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Refinement profile" Style="{StaticResource Label}" /><ComboBox Name="ProfileComboBox" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Try an example" Style="{StaticResource Label}" /><ComboBox Name="ExampleComboBox" ToolTip="Choose an example in a new, empty session." /></StackPanel>
                                </Grid>
                                <Expander Header="Refinement goals" IsExpanded="True" Margin="0,12,0,0">
                                    <TextBox Name="GoalsTextBox" VerticalContentAlignment="Top" AutomationProperties.Name="Refinement goals" AcceptsReturn="True" TextWrapping="Wrap" Height="68" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                                </Expander>
                                <Expander Header="Project context and reference file" Margin="0,12,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBox Name="ProjectContextTextBox" VerticalContentAlignment="Top" AutomationProperties.Name="Project context" AcceptsReturn="True" TextWrapping="Wrap" Height="74" VerticalScrollBarVisibility="Auto" ToolTip="Only the project context you supply is included. No stack or role is assumed." />
                                        <Grid Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Name="FilePathTextBox" IsReadOnly="True" ToolTip="Select a text/source file. The file path alone is not sent to the model." />
                                            <Button Name="BrowseButton" Grid.Column="1" Content="Choose file" Margin="6,0,0,0" />
                                        </Grid>
                                        <CheckBox Name="IncludeFileCheckBox" Content="Include the selected file's text in requests" Margin="0,2,0,6" />
                                        <TextBlock Name="FileSummaryTextBlock" Text="Text files only, up to 256 KB. Preview shows the exact excerpt to be sent." Style="{StaticResource Hint}" />
                                        <TextBox Name="FilePreviewTextBox" IsReadOnly="True" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" FontFamily="Consolas" FontSize="11" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#E2E8F0" />
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,2,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="2. REVIEW AND USE" FontSize="11" FontWeight="Bold" Foreground="#4338CA" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Name="ExportButton" Content="Export Markdown" />
                        </Grid>
                        <TabControl Name="OutputTabs" BorderThickness="0" Background="White">
                            <TabItem Name="DraftTab" Header="Prompt">
                                <DockPanel Margin="4,10,4,4">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Name="CopyButton" Content="Copy prompt" Margin="0,0,8,0" />
                                        <Button Name="UsePromptButton" Content="Use prompt to answer" Style="{StaticResource Primary}" />
                                    </StackPanel>
                                    <TextBox Name="FinalPromptTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" ToolTip="Review or edit the selected draft before using it." />
                                </DockPanel>
                            </TabItem>
                            <TabItem Name="CompareTab" Header="Compare">
                                <DockPanel Margin="4,10,4,4"><TextBlock DockPanel.Dock="Top" Text="Original to selected draft: green additions, red removals." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                    <RichTextBox Name="DiffTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                                </DockPanel>
                            </TabItem>
                            <TabItem Name="HistoryTab" Header="Revisions">
                                <DockPanel Margin="4,10,4,4"><TextBlock DockPanel.Dock="Top" Text="Select a completed revision to review and compare it. Earlier work stays saved." Style="{StaticResource Hint}" Margin="0,0,0,10" />
                                    <ListBox Name="RevisionListBox" DisplayMemberPath="Label" BorderThickness="0" />
                                </DockPanel>
                            </TabItem>
                            <TabItem Name="AnswerTab" Header="Answer">
                                <DockPanel Margin="4,10,4,4"><Button DockPanel.Dock="Bottom" Name="CopyTaskOutputButton" Content="Copy answer" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    <TextBox Name="TaskOutputTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" />
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Grid>
            <Expander Name="ActivityExpander" Grid.Row="2" Header="Activity and diagnostics" Margin="0,10,0,0">
                <DockPanel Margin="0,6,0,0"><StackPanel DockPanel.Dock="Right" Margin="8,0,0,0"><Button Name="ClearLogButton" Content="Clear view" Margin="0,0,0,6" /><Button Name="OpenLogsButton" Content="Open logs" /></StackPanel>
                    <TextBox Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="105" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
                </DockPanel>
            </Expander>
        </Grid>
    </DockPanel>
</Window>
